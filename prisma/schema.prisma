generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String           @id @default(cuid())
  name      String           @unique
  iconCard  String?
  createdAt DateTime         @default(now())
  cards     CollectionCard[]
  decks     Deck[]
  wins      Match[]          @relation("MatchWins")
  losses    Match[]          @relation("MatchLosses")
}

model CollectionCard {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  name      String
  qty       Int     @default(1)
  owned     Boolean @default(true)

  @@unique([profileId, name])
  @@index([profileId])
}

model Deck {
  id        String     @id @default(cuid())
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  name      String
  commander String?
  createdAt DateTime   @default(now())
  cards     DeckCard[]

  @@index([profileId])
}

model DeckCard {
  id      String  @id @default(cuid())
  deck    Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId  String
  name    String
  qty     Int     @default(1)
  isBasic Boolean @default(false)

  @@unique([deckId, name])
  @@index([deckId])
}

model Match {
  id           String   @id @default(cuid())
  winner       Profile  @relation("MatchWins", fields: [winnerId], references: [id], onDelete: Cascade)
  winnerId     String
  loser        Profile  @relation("MatchLosses", fields: [loserId], references: [id], onDelete: Cascade)
  loserId      String
  winnerDeckId String?
  loserDeckId  String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([winnerId])
  @@index([loserId])
}
